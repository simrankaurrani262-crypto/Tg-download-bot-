# ================================================================
# tg-ytdlp-bot — Environment Variables
# Copy this file to .env for local development.
# On Render, set these in the Environment tab of your service.
# ================================================================

# ----------------------------------------------------------------
# REQUIRED — the bot won't start without these
# ----------------------------------------------------------------

# Your bot token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Your Telegram user ID (find it with @userinfobot).
# Comma-separated list for multiple admins, e.g. 123456789,987654321
ADMIN=123456789

# Channel ID for bot logs (negative int). All LOG_* fields can share
# the same channel — just copy the same value for each.
LOGS_ID=-1001234567890

# ----------------------------------------------------------------
# RECOMMENDED
# ----------------------------------------------------------------

# Internal name used in code (no spaces, no @)
BOT_NAME=tgytdlp_bot

# Name stored in the database (usually same as BOT_NAME)
BOT_NAME_FOR_USERS=tgytdlp_bot

# Admin @username, e.g. @your_username
ADMIN_USERNAME=@

# Comma-separated list of group IDs that bypass all limits
# ADMIN_GROUP=-1001234567890

# Comma-separated list of group IDs with increased limits
# ALLOWED_GROUP=-1001234567890

# Individual log channels (defaults to LOGS_ID if left blank)
# LOGS_VIDEO_ID=-1001234567890
# LOGS_NSFW_ID=-1001234567890
# LOGS_IMG_ID=-1001234567890
# LOGS_PAID_ID=-1001234567890
# LOG_EXCEPTION=-1001234567890

# Channel users must subscribe to before using the bot
# SUBSCRIBE_CHANNEL=-1001234567890
# SUBSCRIBE_CHANNEL_URL=https://t.me/your_channel

# ----------------------------------------------------------------
# FIREBASE (optional — disabled by default)
# ----------------------------------------------------------------
USE_FIREBASE=false
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_DATABASE_URL=
# FIREBASE_USER=
# FIREBASE_PASSWORD=

# ----------------------------------------------------------------
# COOKIES (optional — needed for age-restricted / private content)
# ----------------------------------------------------------------
# Public URL that serves your Netscape-format cookie file
# YOUTUBE_COOKIE_URL=https://your-server.com/cookies/youtube.txt
# INSTAGRAM_COOKIE_URL=https://your-server.com/cookies/instagram.txt
# TIKTOK_COOKIE_URL=https://your-server.com/cookies/tiktok.txt
# FACEBOOK_COOKIE_URL=https://your-server.com/cookies/facebook.txt
# TWITTER_COOKIE_URL=https://your-server.com/cookies/twitter.txt

# ----------------------------------------------------------------
# PROXY (optional)
# ----------------------------------------------------------------
# PROXY_TYPE=http
# PROXY_IP=
# PROXY_PORT=3128
# PROXY_USER=
# PROXY_PASSWORD=

# ----------------------------------------------------------------
# PO TOKEN PROVIDER (optional — YouTube bypass)
# ----------------------------------------------------------------
YOUTUBE_POT_ENABLED=false
# YOUTUBE_POT_BASE_URL=http://localhost:4416

# ----------------------------------------------------------------
# MISC
# ----------------------------------------------------------------
TZ=UTC
